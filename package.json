{
  "name": "juyel-cosmic-portfolio",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "eslint .",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\" \"index.html\" \"*.{js,json,ts}\" \".github/workflows/*.yml\" \"README.md\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\" \"index.html\" \"*.{js,json,ts}\" \".github/workflows/*.yml\" \"README.md\"",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "build": "tsc -b && vite build",
    "validate:release-tag": "node scripts/validate-release-tag.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@vitejs/plugin-react": "latest",
    "axios": "^1.21.0",
    "lucide-react": "^0.468.0",
    "motion": "latest",
    "react": "latest",
    "react-dom": "latest",
    "simple-icons": "^16.35.0",
    "three": "^0.186.1",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.28.6",
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
