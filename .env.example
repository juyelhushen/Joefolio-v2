# Optional public base URL for the separately deployed assistant service.
# Leave empty to hide the launcher until the backend implements docs/ai-assistant-api.md.
VITE_AI_ASSISTANT_API_URL=

# Public Spring Boot API URL. Development forwards /backend here through Vite's server proxy.
# Production calls this URL directly; the backend must allow the production origin.
# Never place credentials or private backend settings in VITE_ variables.
VITE_API_BASE_URL=https://joefolio-backend.onrender.com
