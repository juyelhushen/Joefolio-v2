# Optional public base URL for the separately deployed assistant service.
# Leave empty until the backend implements the contract in docs/ai-assistant-api.md.
VITE_AI_ASSISTANT_API_URL=

# Server-only contact mail settings. Configure these in Vercel and in .env.local.
# Use a verified sender identity and a private recipient address.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
CONTACT_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
