# Optional public base URL for the separately deployed assistant service.
# Leave empty until the backend implements the contract in docs/ai-assistant-api.md.
VITE_AI_ASSISTANT_API_URL=

# Public Spring Boot API URL. Use the deployed Render service locally and in production.
# Never place credentials or private backend settings in VITE_ variables.
VITE_API_BASE_URL=https://joefolio-backend.onrender.com
